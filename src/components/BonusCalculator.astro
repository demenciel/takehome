---
import ProvinceSelect from './ProvinceSelect.astro';

interface Props {
  province?: string;
}

const { province = '' } = Astro.props;
---

<div class="rounded-2xl border border-line bg-card p-5 shadow-sm sm:p-8" data-bonus>
  <form class="space-y-5" data-bonus-form novalidate>
    <ProvinceSelect value={province} />
    <div>
      <label for="salary" class="mb-2 block text-sm font-semibold">Current annual salary</label>
      <input id="salary" name="salary" type="text" inputmode="decimal" class="input-field" placeholder="80,000" value="80000" />
    </div>
    <div>
      <label for="bonus" class="mb-2 block text-sm font-semibold">Bonus</label>
      <input id="bonus" name="bonus" type="text" inputmode="decimal" class="input-field" placeholder="10,000" value="10000" />
    </div>
    <button type="submit" class="btn-primary">Calculate net bonus</button>
    <p data-error class="text-sm text-deduct" hidden></p>
  </form>
  <div data-result class="mt-8" hidden></div>
</div>
<script>
  import { initBonus } from '../scripts/bonus';
  initBonus();
</script>
