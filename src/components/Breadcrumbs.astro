---
import type { BreadcrumbItem } from '../lib/seo';

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-4 pt-6 sm:px-6">
  <ol class="flex flex-wrap gap-2 text-sm text-ink-soft">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && <span aria-hidden="true">/</span>}
        {index === items.length - 1 ? (
          <span class="text-ink">{item.name}</span>
        ) : (
          <a href={new URL(item.url).pathname || '/'} class="hover:text-ink">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
