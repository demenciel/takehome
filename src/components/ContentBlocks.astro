---
interface Props {
  blocks: Array<{ heading: string; copy: string }>;
}

const { blocks } = Astro.props;
---

<section class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
  {blocks.map((block) => (
    <article class="mt-8 first:mt-0">
      <h2 class="font-serif text-3xl">{block.heading}</h2>
      <p class="mt-4 text-ink-soft">{block.copy}</p>
    </article>
  ))}
</section>
