---
interface Props {
  mode: 'hourly_to_salary' | 'salary_to_hourly';
}

const { mode } = Astro.props;
---

<div class="rounded-2xl border border-line bg-card p-5 shadow-sm sm:p-8" data-conversion>
  <form class="space-y-5" data-conversion-form data-mode={mode} novalidate>
    {mode === 'hourly_to_salary' ? (
      <div>
        <label for="hourlyWage" class="mb-2 block text-sm font-semibold">Hourly wage</label>
        <input id="hourlyWage" name="hourlyWage" type="text" inputmode="decimal" class="input-field" placeholder="40.00" />
      </div>
    ) : (
      <div>
        <label for="salary" class="mb-2 block text-sm font-semibold">Annual salary</label>
        <input id="salary" name="salary" type="text" inputmode="decimal" class="input-field" placeholder="80,000" value="80000" />
      </div>
    )}
    <div>
      <label for="hoursPerWeek" class="mb-2 block text-sm font-semibold">Hours per week</label>
      <input id="hoursPerWeek" name="hoursPerWeek" type="text" inputmode="decimal" class="input-field" value="40" />
    </div>
    <button type="submit" class="btn-primary">{mode === 'hourly_to_salary' ? 'Convert to salary' : 'Convert to hourly'}</button>
    <p data-error class="text-sm text-deduct" hidden></p>
  </form>
  <div data-result class="mt-8" hidden></div>
</div>
<script>
  import { initConversion } from '../scripts/conversion';
  initConversion();
</script>
