---
import type { FaqItem } from '../lib/seo';

interface Props {
  faqs: FaqItem[];
}

const { faqs } = Astro.props;
---

{faqs.length > 0 && (
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h2 class="font-serif text-3xl">Frequently asked questions</h2>
    <div class="mt-6 space-y-4">
      {faqs.map((faq) => (
        <details class="rounded-2xl border border-line bg-card p-5">
          <summary class="cursor-pointer font-semibold">{faq.question}</summary>
          <p class="mt-3 text-ink-soft">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}
