---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AnswerSummary from '../components/AnswerSummary.astro';
import Faq from '../components/Faq.astro';
import Related from '../components/Related.astro';
import ContentBlocks from '../components/ContentBlocks.astro';
import PaycheckCalculator from '../components/PaycheckCalculator.astro';
import { hubAnswer } from '../lib/answers';
import { HUBS } from '../lib/content/hubs';
import { relatedLinks } from '../lib/related';
import { absoluteUrl } from '../lib/catalog';

const page = HUBS.paycheque;
const faqs = [...page.faqs];
const seo = {
  title: page.title,
  description: page.description,
  canonical: absoluteUrl('/paycheque-calculator'),
  breadcrumbs: [
    { name: 'Home', url: absoluteUrl('/') },
    { name: page.h1, url: absoluteUrl('/paycheque-calculator') },
  ],
  faqs,
};
---

<Base seo={seo}>
  <Breadcrumbs items={seo.breadcrumbs} />
  <section class="mx-auto max-w-6xl px-4 pb-8 pt-8 sm:px-6">
    <h1 class="font-serif text-4xl sm:text-5xl">{page.h1}</h1>
    <AnswerSummary class="mt-6" summary={hubAnswer(page.summaryQuestion, page.summaryAnswer)} />
    <p class="mt-4 max-w-2xl text-lg text-ink-soft">{page.intro}</p>
    <div class="mt-8 max-w-2xl">
      <PaycheckCalculator />
    </div>
  </section>
  <ContentBlocks blocks={[...page.sections]} />
  <Faq faqs={faqs} />
  <Related links={relatedLinks()} />
</Base>
